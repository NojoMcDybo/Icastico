{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icastico",
  "version": "../package.json",
  "identifier": "io.github.nojomcdybo.icastico",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Icastico",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Notensatz als individuelle Workstation",
    "copyright": "Copyright © 2026 Icastico-Mitwirkende · GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German",
          "English"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "icastico"
        ],
        "name": "Icastico-Partitur",
        "description": "Icastico-Partitur",
        "role": "Editor",
        "mimeType": "application/x-icastico"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMjE5M0UwRTBBM0M2OTcKUldTWHhxUGc0Sk1obmRJc0hNSDlLVldiUWcxOTVWU25JbWUvK3owRlFkMmJwSHFKVGVxeHJGMmwK",
      "endpoints": [
        "https://github.com/NojoMcDybo/Icastico/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
