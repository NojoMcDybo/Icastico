        },
        {
          "id": "edit.cut",
          "title": "Ausschneiden",
          "finale": { "keys": ["Mod+X"], "source": "doku" },
          "logic": { "keys": ["Mod+X"], "source": "doku" }
        },
        {
          "id": "edit.selectAll",
          "title": "Alles auswählen",
          "finale": { "keys": ["Mod+A"], "source": "doku" },
          "logic": { "keys": ["Mod+A"], "source": "doku" }
        },
        {
          "id": "edit.quantize",
          "title": "Quantisieren (eingespielte Noten ins Raster)",
          "logic": { "keys": ["Q"], "source": "doku" }
        }
      ]
    },
    {
      "title": "Bewegen",
      "functions": [
        {
          "id": "nav.horizontal",
          "title": "Vor / zurück",
          "command": "nav.horizontal",
          "args": { "1": "vor", "-1": "zurück" },
          "finale": { "keys": { "1": ["ArrowRight"], "-1": ["ArrowLeft"] }, "source": "annahme" },
          "logic": { "keys": { "1": ["ArrowRight"], "-1": ["ArrowLeft"] }, "source": "doku", "note": "Logic: nächstes / voriges Ereignis auswählen." }
        },
        {
          "id": "nav.staff",
          "title": "System wechseln",
          "command": "nav.staff",
