          "finale": { "keys": ["Mod+Z"], "source": "doku" },
          "logic": { "keys": ["Mod+Z"], "source": "doku" }
        },
        {
          "id": "history.redo",
          "title": "Wiederholen",
          "command": "history.redo",
          "finale": { "keys": ["Mod+Y", "Mod+Shift+Z"], "source": "doku" },
          "logic": { "keys": ["Mod+Shift+Z"], "source": "doku" }
        },
        {
          "id": "edit.copy",
          "title": "Kopieren",
          "finale": { "keys": ["Mod+C"], "source": "doku" },
          "logic": { "keys": ["Mod+C"], "source": "doku" }
        },
        {
          "id": "edit.paste",
          "title": "Einfügen",
