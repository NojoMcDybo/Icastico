{
  "name": "icastico",
  "private": true,
  "version": "0.14.0",
  "description": "Icastico – Notensatz als individuelle Workstation",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "sounds": "node scripts/fetch-sounds.mjs",
    "voice": "node scripts/fetch-voice.mjs",
    "predev": "npm run sounds && npm run voice",
    "dev": "vite",
    "prebuild": "npm run sounds && npm run voice",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshot": "node scripts/screenshot.mjs",
    "e2e": "node scripts/e2e.mjs",
    "keys:doc": "vitest run src/ui/keys.test.ts -u",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "fflate": "^0.8.3",
    "spessasynth_lib": "^4.4.3",
    "verovio": "6.3.0",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
